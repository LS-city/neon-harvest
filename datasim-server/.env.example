# Copy this file, name the copy ".env", and fill it in.

# Free key from Google Cloud (see README step 2). Leave blank to run with Wikipedia only.
YOUTUBE_API_KEY=

# Wikimedia asks automated tools to include a way to reach the owner.
CONTACT_EMAIL=

# How long each topic's results are reused before asking the sources again.
CACHE_HOURS=6

PORT=3000

# Set to 1 to test without internet. Rows are clearly marked as test data.
DATASIM_MOCK=0
