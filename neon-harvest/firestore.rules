rules_version = '2';
// NEON HARVEST: Cloud Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isOwner() {
      return signedIn() && request.auth.token.email == "fouredwinx@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Display names other players see.
    match /profiles/{uid} { allow read: if signedIn(); allow write: if signedIn() && me() == uid; }

    // Each player's private save. Nobody else can read or change it.
    match /data/users/{uid}/{rest=**} { allow read, write: if signedIn() && me() == uid; }

    // Apartments (shelves, look, decor, name, wins): readable by all, writable by the owner of the apartment.
    match /homes/{uid} { allow read: if signedIn(); allow write: if signedIn() && me() == uid; }

    // Gifts and bounties: you can only send as yourself; the sender or receiver can remove one.
    match /gifts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == me();
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
    }

    // Trade board: you can only list as yourself; anyone can remove a listing when buying it.
    match /market/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.seller == me();
      allow delete: if signedIn();
    }

    // Player orders to bar/club staff.
    match /orders/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == me();
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
    }

    // Wager duels: only the two players can change a duel.
    match /duels/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == me();
      allow update: if signedIn() && (resource.data.a == me() || resource.data.b == me());
    }
    match /pot/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me();
      allow delete: if signedIn();
    }

    // Shared game state: shift slots, DJ track, username registry.
    match /staff/{id} { allow read, write: if signedIn(); }
    match /cbstaff/{id} { allow read, write: if signedIn(); }
    match /clubstaff/{id} { allow read, write: if signedIn(); }
    match /club/{id} { allow read, write: if signedIn(); }
    match /handles/{id} { allow read, write: if signedIn(); }

    // Smacked Shop: everyone can browse, only the owner can stock it or mark pickups.
    match /shop/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /shopinfo/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /pickups/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /assets/{id} { allow read: if signedIn(); allow write: if isOwner(); }

    // Private and group messages: every member gets their own copy in their inbox.
    // Only the inbox owner can read or delete it; anyone signed in can deliver, but only as themselves.
    match /inbox/{uid}/msgs/{id} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.chat is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 200;
    }

    // Linx Land: one plot per player (the document id is the player's id). Everyone can see who owns what.
    match /land/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid && request.resource.data.plot is int
        && request.resource.data.plot >= 0 && request.resource.data.plot < 1000;
      allow delete: if signedIn() && me() == uid;
    }

    // Backrooms (rentable rooms in The Glitch and The Third Eye). Only the current renter can change a room;
    // anyone can take it over once the rental has run out.
    match /viprooms/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me();
      allow update: if signedIn() && request.resource.data.by == me()
        && (resource.data.by == me() || resource.data.until < request.time.toMillis());
      allow delete: if false;
    }

    // Data Collectors Club: everyone can see who is a member; only the owner can grant, change or remove.
    // Members can change only their own symbol.
    match /dcc/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
      allow update: if signedIn() && me() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sym'])
        && request.resource.data.sym is int && request.resource.data.sym >= 0 && request.resource.data.sym < 20;
    }
    // Join requests: a player says they paid with PayPal and picks a symbol; only the owner approves.
    match /dccreq/{uid} {
      allow read: if signedIn() && (me() == uid || isOwner());
      allow create, update: if isOwner() || (signedIn() && me() == uid && request.resource.data.status == 'pending'
        && request.resource.data.sym is int && request.resource.data.sym >= 0 && request.resource.data.sym < 20
        && request.resource.data.paypal is string && request.resource.data.paypal.size() <= 120);
      allow delete: if isOwner();
    }

    // Pickup codes: private to the player who redeemed them, plus the owner.
    // Adding a NEW code (redeeming) needs an active Data Collectors Club membership (or the owner).
    // Anyone can still update their existing codes (refund flags) without adding new ones.
    function dccDoc() { return get(/databases/$(database)/documents/dcc/$(request.auth.uid)).data; }
    function isMember() {
      return exists(/databases/$(database)/documents/dcc/$(request.auth.uid))
        && dccDoc().on == true && (dccDoc().until == 0 || dccDoc().until > request.time.toMillis());
    }
    function addsCode() {
      return request.resource.data.codes.size() > (resource == null ? 0 : resource.data.codes.size())
        || (resource != null && request.resource.data.codes.size() > 0
            && request.resource.data.codes[request.resource.data.codes.size() - 1].code
               != resource.data.codes[resource.data.codes.size() - 1].code);
    }
    // Monthly reward limit. Every new code must carry the item's real cost in cents (as stocked by the owner),
    // and the player's running total for this calendar month (UTC) can't go over shopinfo/econ.capc (default $14).
    // Players can't lower or reset their own total: any write that doesn't add a code must leave it unchanged.
    function econCap() {
      return exists(/databases/$(database)/documents/shopinfo/econ)
        ? get(/databases/$(database)/documents/shopinfo/econ).data.get('capc', 1400) : 1400;
    }
    function thisMonth() { return string(request.time.year()) + '-' + string(request.time.month()); }
    function prevSpent() {
      return (resource != null && resource.data.get('month', '') == thisMonth()) ? resource.data.get('spentc', 0) : 0;
    }
    function newCode() { return request.resource.data.codes[request.resource.data.codes.size() - 1]; }
    function withinLimit() {
      return newCode().cents is int && newCode().cents > 0 && newCode().item is string
        && exists(/databases/$(database)/documents/shop/$(newCode().item))
        && get(/databases/$(database)/documents/shop/$(newCode().item)).data.get('cents', 0) == newCode().cents
        && request.resource.data.month == thisMonth()
        && request.resource.data.spentc == prevSpent() + newCode().cents
        && request.resource.data.spentc <= econCap();
    }
    function keepsTotals() {
      return request.resource.data.get('month', '') == (resource == null ? '' : resource.data.get('month', ''))
        && request.resource.data.get('spentc', 0) == (resource == null ? 0 : resource.data.get('spentc', 0));
    }
    // Neon Row: storefronts the owner rents to local businesses.
    // The owner sets each store (look, info, the partner's email, rent paid until). While the rent is paid,
    // the partner, signed in with that verified email, manages their own rewards and pickup codes.
    function rowDoc(slot) { return get(/databases/$(database)/documents/row/$(slot)).data; }
    function isPartner(slot) {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/row/$(slot))
        && rowDoc(slot).get('email', '') == request.auth.token.email.lower()
        && rowDoc(slot).get('active', false) == true
        && rowDoc(slot).get('until', 0) > request.time.toMillis();
    }
    match /row/{slot} { allow read: if signedIn(); allow write: if isOwner(); }

    // Neon Row Coins (NRC): everyone earns them, up to a daily cap (double for members), and spends them only at Neon Row.
    // Earning can only add up to the cap for today (UTC). Spending and refunds must be paired with their pickup code
    // in the same batch, so a balance can only change through real play or a real redemption.
    function today() { return string(request.time.year()) + '-' + string(request.time.month()) + '-' + string(request.time.day()); }
    function nrcCap() { return isMember() ? 600 : 300; }
    function nd() { return request.resource.data; }
    function od() { return resource.data; }
    function nrcEarn() {
      return nd().diff(od()).affectedKeys().hasOnly(['bal', 'day', 'got', 'total'])
        && nd().bal is int && nd().bal > od().bal && nd().day == today()
        && nd().got == (od().get('day', '') == today() ? od().get('got', 0) : 0) + (nd().bal - od().bal)
        && nd().got <= nrcCap() && nd().total == od().get('total', 0) + (nd().bal - od().bal);
    }
    function codeAt(slot, code) { return /databases/$(database)/documents/rowcodes/$(slot)/codes/$(code); }
    function nrcSpend() {
      return nd().diff(od()).affectedKeys().hasOnly(['bal', 'ls', 'lc'])
        && nd().bal is int && nd().bal >= 0 && nd().bal < od().bal
        && nd().ls is string && nd().lc is string
        && !exists(codeAt(nd().ls, nd().lc))
        && getAfter(codeAt(nd().ls, nd().lc)).data.by == me()
        && getAfter(codeAt(nd().ls, nd().lc)).data.cur == 'nrc'
        && getAfter(codeAt(nd().ls, nd().lc)).data.nrc == od().bal - nd().bal;
    }
    function nrcRefund() {
      return nd().diff(od()).affectedKeys().hasOnly(['bal', 'rs', 'rc'])
        && nd().rs is string && nd().rc is string
        && get(codeAt(nd().rs, nd().rc)).data.by == me()
        && get(codeAt(nd().rs, nd().rc)).data.cur == 'nrc'
        && get(codeAt(nd().rs, nd().rc)).data.status == 'cancelled'
        && get(codeAt(nd().rs, nd().rc)).data.get('refunded', false) == false
        && getAfter(codeAt(nd().rs, nd().rc)).data.refunded == true
        && nd().bal == od().bal + get(codeAt(nd().rs, nd().rc)).data.nrc;
    }
    match /nrc/{uid} {
      allow read: if signedIn() && (me() == uid || isOwner());
      allow create: if signedIn() && me() == uid && nd().keys().hasOnly(['bal', 'day', 'got', 'total'])
        && nd().bal is int && nd().bal > 0 && nd().day == today() && nd().got == nd().bal
        && nd().total == nd().bal && nd().bal <= nrcCap();
      allow update: if signedIn() && me() == uid && (nrcEarn() || nrcSpend() || nrcRefund());
      allow delete: if false;
    }
    match /rowitems/{slot}/items/{id} {
      allow read: if signedIn();
      allow create, delete: if isOwner() || isPartner(slot);
      // Partners edit their rewards; a player redeeming can only add 1 to "sold", up to the stock.
      allow update: if isOwner() || isPartner(slot)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold'])
            && request.resource.data.sold == resource.data.sold + 1 && request.resource.data.sold <= resource.data.stock);
    }
    function rowPaid(slot, code, item) {
      return (request.resource.data.cur == 'rp' && isMember() && item.get('cur', 'rp') == 'rp' && item.rp == request.resource.data.rp)
        || (request.resource.data.cur == 'nrc' && item.get('cur', 'rp') == 'nrc' && item.nrc == request.resource.data.nrc
            && getAfter(/databases/$(database)/documents/nrc/$(request.auth.uid)).data.bal
               == get(/databases/$(database)/documents/nrc/$(request.auth.uid)).data.bal - request.resource.data.nrc
            && getAfter(/databases/$(database)/documents/nrc/$(request.auth.uid)).data.lc == code);
    }
    match /rowcodes/{slot}/codes/{code} {
      allow read: if isOwner() || isPartner(slot) || (signedIn() && resource.data.by == me());
      // Players redeem as themselves, at the reward's real price: NRC rewards are open to everyone and must be paid
      // from the player's NRC balance in the same batch; RP rewards are for Data Collectors Club members.
      allow create: if signedIn() && request.resource.data.by == me()
        && request.resource.data.status == 'ready' && request.resource.data.slot == slot && request.resource.data.code == code
        && request.resource.data.item is string
        && exists(/databases/$(database)/documents/rowitems/$(slot)/items/$(request.resource.data.item))
        && rowPaid(slot, code, get(/databases/$(database)/documents/rowitems/$(slot)/items/$(request.resource.data.item)).data);
      // The store (or the owner) marks a ready code picked up or cancelled, once.
      // The player can only flag their own cancelled code as refunded, once.
      allow update: if ((isOwner() || isPartner(slot)) && resource.data.status == 'ready'
            && request.resource.data.status in ['picked', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'done']))
        || (signedIn() && resource.data.by == me() && resource.data.status == 'cancelled'
            && resource.data.get('refunded', false) == false && request.resource.data.refunded == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refunded']))
        // A digital reward is delivered in the game, so the player's own code is marked picked up right away.
        || (signedIn() && resource.data.by == me() && resource.data.status == 'ready'
            && resource.data.get('dig', '') != ''
            && get(/databases/$(database)/documents/rowitems/$(slot)/items/$(resource.data.item)).data.get('dig', '') == resource.data.dig
            && request.resource.data.status == 'picked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'done']));
      allow delete: if false;
    }

    // Neon Row interiors: layout, hired staff, posters and ads, order alerts. Each store's partner (or the owner) edits their own.
    match /rowin/{slot} {
      allow read: if signedIn();
      allow write: if (isOwner() || isPartner(slot)) && slot in ['s1', 's2', 's3', 's4', 's5', 's6']
        && request.resource.data.keys().hasOnly(['lay', 'clerk', 'greeter', 'greet', 'posters', 'screen', 'out', 'notify', 'pk', 'at']);
    }
    // Order emails for Neon Row partners (sent by the Trigger Email extension). A player can only queue one email,
    // for their own real order, to that store's own email, and only when the store turned email alerts on.
    match /mail/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'message', 'slot', 'code', 'at'])
        && nd().slot in ['s1', 's2', 's3', 's4', 's5', 's6'] && nd().code is string
        && id == 'row_' + nd().slot + '_' + nd().code
        && get(/databases/$(database)/documents/rowcodes/$(nd().slot)/codes/$(nd().code)).data.by == me()
        && get(/databases/$(database)/documents/rowin/$(nd().slot)).data.get('notify', false) == true
        && nd().to == [rowDoc(nd().slot).get('email', '')]
        && nd().message.keys().hasOnly(['subject', 'text'])
        && nd().message.subject is string && nd().message.subject.size() <= 120
        && nd().message.text is string && nd().message.text.size() <= 1000;
      allow read, update, delete: if isOwner();
    }
    // Gamers Den boards: game nights, anime watch parties and events. Signed-in players read; you post and remove your own; the owner can remove any.
    match /denposts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && nd().by == me()
        && nd().keys().hasOnly(['by', 'name', 'kind', 'title', 'detail', 'plat', 'where', 'discord', 'showName', 'when', 'until', 'at'])
        && nd().kind in ['game', 'watch', 'event']
        && nd().title is string && nd().title.size() > 0 && nd().title.size() <= 50
        && nd().detail is string && nd().detail.size() <= 160
        && nd().discord is string && nd().discord.size() <= 40
        && nd().name is string && nd().name.size() <= 24
        && nd().plat is string && nd().plat.size() <= 20 && nd().where is string && nd().where.size() <= 30
        && nd().until is int && nd().until <= request.time.toMillis() + 15 * 86400000;
      allow delete: if isOwner() || (signedIn() && resource.data.by == me());
    }
    // Neon Row Specials: digital items the owner designs for a store. Everyone can see them; only the owner makes them.
    match /rowdigi/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    // Requests from a store's partner to the owner for a special item. The partner sees only their own.
    match /rowreqs/{id} {
      allow read: if isOwner() || (signedIn() && resource.data.by == me());
      allow create: if signedIn() && nd().slot is string && isPartner(nd().slot) && nd().by == me() && nd().status == 'open'
        && nd().keys().hasOnly(['slot', 'store', 'by', 'byName', 'title', 'idea', 'extra', 'status', 'reply', 'at'])
        && nd().title is string && nd().title.size() > 0 && nd().title.size() <= 60
        && nd().idea is string && nd().idea.size() <= 500 && nd().extra is string && nd().extra.size() <= 80
        && nd().reply == '' && nd().at is int;
      allow update: if isOwner()
        || (signedIn() && od().by == me() && od().status == 'open' && nd().status == 'cancelled'
            && nd().diff(od()).affectedKeys().hasOnly(['status']));
      allow delete: if isOwner();
    }

    // Store insights: one anonymous visit counter per player, per store, per day. Players write only their own;
    // only that store's partner (and the owner) can read the counts.
    match /rowvisits/{slot}/v/{id} {
      allow read: if isOwner() || isPartner(slot) || (signedIn() && id.matches('^[0-9]+_' + me() + '$'));
      allow create, update: if signedIn() && id == string(nd().d) + '_' + me()
        && nd().keys().hasOnly(['d', 'n', 'hr', 'views', 'ret', 'at'])
        && nd().d is int && nd().d > request.time.toMillis() / 86400000 - 2 && nd().d < request.time.toMillis() / 86400000 + 1
        && nd().n is int && nd().n >= 1 && nd().n <= 300
        && nd().hr is map && nd().hr.size() <= 24 && nd().views is map && nd().views.size() <= 50
        && nd().ret is bool && nd().at is int;
      allow delete: if isOwner();
    }

    // Car Display: one plot per player (the document id is the player's id). Everyone can see every plot.
    match /carplots/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid && nd().plot is int && nd().plot >= 0 && nd().plot < 1000
        && nd().cars is list && nd().cars.size() <= 3;
      allow delete: if isOwner() || (signedIn() && me() == uid);
    }

    // ---------- MyDex ----------
    function mdOk() { return signedIn() && !exists(/databases/$(database)/documents/mdBans/$(me())); }
    function mdDef(d) { return d is map && d.name is string && d.name.size() <= 40; }
    function mdReq(id) { return get(/databases/$(database)/documents/mdReq/$(id)).data; }

    match /mdConfig/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /mdBans/{uid} { allow get: if signedIn() && (me() == uid || isOwner()); allow list, write: if isOwner(); }
    match /mdOfficial/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /mdVenues/{id} { allow read: if signedIn(); allow write: if isOwner(); }
    match /mdBlocks/{uid} { allow read, write: if signedIn() && me() == uid; }

    // Public player cards. Only 21+ ages, and picture sizes are capped.
    match /mdCards/{uid} {
      allow read: if signedIn();
      allow update: if isOwner();
      allow create, update: if mdOk() && me() == uid
        && nd().name is string && nd().name.size() > 0 && nd().name.size() <= 18
        && nd().age is int && nd().age >= 21 && nd().age <= 99
        && nd().bio is string && nd().bio.size() <= 120
        && nd().mood in ['g', 'y', 'r']
        && nd().photo is string && nd().photo.size() <= 70000
        && nd().img is string && nd().img.size() <= 150000;
      allow delete: if isOwner() || (signedIn() && me() == uid);
    }

    // Radar: opt-in, coarse area only (about 1 km). Never exact coordinates.
    match /mdPres/{uid} {
      allow read: if signedIn();
      allow create, update: if mdOk() && me() == uid && nd().keys().hasOnly(['name', 'cell', 'mood', 'at'])
        && nd().cell is string && nd().cell.size() <= 20;
      allow delete: if isOwner() || (signedIn() && me() == uid);
    }

    // Each player's own badge design: 200 copies, one more at a time, and the design can't be edited.
    match /mdDesigns/{uid} {
      allow read: if signedIn();
      allow create: if mdOk() && me() == uid && nd().minted == 0 && nd().off == false && mdDef(nd().def);
      allow update: if isOwner()
        || (mdOk() && me() == uid && od().off == false && nd().diff(od()).affectedKeys().hasOnly(['minted'])
            && nd().minted == od().minted + 1 && nd().minted <= 200);
      allow delete: if isOwner();
    }

    // Every badge is one document with one owner.
    function mdDesignAfter() { return getAfter(/databases/$(database)/documents/mdDesigns/$(me())).data; }
    function mdCustomOk(id) {
      return nd().kind == 'custom' && nd().serial is int && nd().serial >= 1 && nd().serial <= 200
        && id == me() + '_c_' + string(nd().serial)
        && mdDesignAfter().minted == nd().serial && mdDesignAfter().off == false;
    }
    function mdSelfKind(id) {
      return nd().kind in ['goal', 'starter', 'item', 'pet'] && id.matches('^' + me() + '_.+');
    }
    function mdStaff(venue) {
      return me() in get(/databases/$(database)/documents/mdVenues/$(venue)).data.get('staff', []);
    }
    function mdTransferKeys() { return nd().diff(od()).affectedKeys().hasOnly(['owner', 'from', 'at', 'via']); }
    match /mdBadges/{id} {
      allow read: if signedIn();
      allow create: if isOwner()
        || (mdOk() && nd().by == me() && mdDef(nd().def) && nd().owner == me() && (mdSelfKind(id) || mdCustomOk(id)))
        || (mdOk() && nd().by == me() && mdDef(nd().def) && nd().kind == 'venue' && mdStaff(nd().venue));
      allow update: if isOwner()
        // The owner restyles a forged badge. The item art, rarity and category can't change.
        || (mdOk() && od().owner == me() && od().kind in ['item', 'pet']
            && nd().diff(od()).affectedKeys().hasOnly(['def', 'styled'])
            && mdDef(nd().def) && nd().def.name.size() >= 2 && nd().styled is int
            && od().def.get('art', null) != null
            && nd().def.get('art', null) == od().def.get('art', null)
            && nd().def.get('r', 0) == od().def.get('r', 0)
            && nd().def.get('cat', '') == od().def.get('cat', ''))
        // The owner hands it over, and only as part of a real request.
        || (mdOk() && od().owner == me() && mdTransferKeys() && nd().owner != me()
            && (mdReq(nd().via).from == me() || mdReq(nd().via).to == me()))
        // The receiver accepts something the owner offered and that is still pending.
        || (mdOk() && mdTransferKeys() && nd().owner == me()
            && mdReq(nd().via).to == me() && mdReq(nd().via).from == od().owner
            && mdReq(nd().via).give == id && mdReq(nd().via).status == 'pending');
      allow delete: if isOwner();
    }

    // Requests: the sender must own what they offer, and red status or a block stops them.
    function mdTargetOpen() {
      return exists(/databases/$(database)/documents/mdCards/$(nd().to))
        && get(/databases/$(database)/documents/mdCards/$(nd().to)).data.mood != 'r'
        && (!exists(/databases/$(database)/documents/mdBlocks/$(nd().to))
            || !(me() in get(/databases/$(database)/documents/mdBlocks/$(nd().to)).data.list));
    }
    match /mdReq/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me() || isOwner());
      allow create: if mdOk() && nd().from == me() && nd().to != me() && nd().status == 'pending'
        && nd().type in ['ex', 'send', 'gift', 'swap'] && mdTargetOpen()
        && getAfter(/databases/$(database)/documents/mdBadges/$(nd().give)).data.owner == me();
      allow update: if signedIn() && od().status == 'pending' && nd().diff(od()).affectedKeys().hasOnly(['status', 'done'])
        && ((od().to == me() && nd().status in ['ok', 'no']) || (od().from == me() && nd().status == 'no'));
      allow delete: if signedIn() && (od().from == me() || od().to == me() || isOwner());
    }

    // Encounters: written by the person who approved a real in-person badge exchange.
    match /mdEnc/{pair} {
      allow read: if isOwner() || (signedIn() && me() in resource.data.members);
      allow create, update: if mdOk() && nd().members is list && nd().members.size() == 2
        && me() in nd().members && nd().members[0] < nd().members[1]
        && pair == nd().members[0] + '_' + nd().members[1]
        && mdReq(nd().req).to == me() && mdReq(nd().req).from in nd().members
        && mdReq(nd().req).near == true && mdReq(nd().req).type in ['ex', 'send']
        && mdReq(nd().req).status == 'pending';
      allow delete: if isOwner();
    }

    match /mdSpots/{id} {
      allow read: if signedIn();
      allow create: if mdOk() && nd().by == me() && nd().name is string && nd().name.size() <= 30
        && nd().info is string && nd().info.size() <= 200 && nd().lat is number && nd().lng is number;
      allow update: if isOwner() || (signedIn() && od().by == me())
        || (mdOk() && nd().diff(od()).affectedKeys().hasOnly(['views']) && nd().views == od().views + 1);
      allow delete: if isOwner() || (signedIn() && od().by == me());
    }

    match /mdVisits/{id} {
      allow read: if signedIn();
      allow create: if mdOk() && nd().uid == me() && nd().status == 'pending' && id == me() + '_' + nd().venue + '_' + nd().day;
      allow update: if isOwner() || (mdOk() && mdStaff(od().venue) && nd().diff(od()).affectedKeys().hasOnly(['status', 'by']));
      allow delete: if isOwner();
    }

    match /mdReports/{id} {
      allow create: if mdOk() && nd().by == me() && nd().text is string && nd().text.size() <= 300;
      allow read, delete: if isOwner();
    }

    match /redeem/{uid} {
      allow read: if signedIn() && (me() == uid || isOwner());
      allow write: if signedIn() && me() == uid
        && ((addsCode() && (isMember() || isOwner()) && withinLimit()) || (!addsCode() && keepsTotals()));
    }
  }
}
